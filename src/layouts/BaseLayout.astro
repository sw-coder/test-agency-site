---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import siteData from '../data/siteData.json';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteData.businessName, description = siteData.tagline } = Astro.props;
---

<!usr/bin/env html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteData.businessName}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen antialiased">
    
    <!-- Header / Nav -->
    <header class="bg-slate-900 text-white p-4 sticky top-0 z-50 shadow-md">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <a href="/" class="text-xl font-bold tracking-wide">{siteData.businessName}</a>
        <nav class="hidden md:flex gap-6 text-sm font-medium">
          <a href="/" class="hover:text-sky-400 transition">Home</a>
          <a href="/about" class="hover:text-sky-400 transition">About</a>
          <a href="/services" class="hover:text-sky-400 transition">Services</a>
          <a href="/portfolio" class="hover:text-sky-400 transition">Portfolio</a>
          <a href="/contact" class="hover:text-sky-400 transition">Contact</a>
        </nav>
      </div>
    </header>

    <!-- Page Content Inserted Here -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-8 px-4 border-t border-slate-800 text-sm">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
        <p>&copy; {new Date().getFullYear()} {siteData.businessName}. All rights reserved.</p>
        <p>{siteData.address} | Phone: {siteData.phone}</p>
      </div>
    </footer>

  </body>
</html>
